  bg_song: {fileID: 2080166303}
  TLST: {fileID: 1762884696}
  anim: {fileID: 429039884}
  dialogueText: {fileID: 1120618340}
  lines:
  - hello!!! :3
  - nice to meet you!!!
  - it has been so long since the last time somebody visited this place.
  - 'let me introduce myself, i am the MASTER of C shrine.  '
  - this place was given to me by a generous admin called Lomgle!!!
  - i play REAL 'BOUT CLASH, a very sybau game on roblox.
  - thats really all you should know about me.
  - what is your name?
  - . . .
  - ic, you invoked your rights to stay silent.
  - how did you get here and what is your purpose??
  - . . .
  - . . .
  - ANSWER NOW!
  - QUAT
  - WHAR DID I DO
  - SPEAK UP
  - HEY
  - CON NGUOI
  - noidaukhophai
  - noidaukhongthedientabangloi
  - . . .
  - oh the horrors of humanitt. . .
  - you have enraged the timeskip Ox,
  - now you shall pay the price. . .
  textSpeed: 0.06
  transition_time: 2.5
  questions: {fileID: 1519720883}
